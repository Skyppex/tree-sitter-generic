{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "generic",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "encapsulation"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "special_char"
        },
        {
          "type": "SYMBOL",
          "name": "white_space"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "PATTERN",
              "value": "[^\\\"]*"
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "PATTERN",
              "value": "[^\\\"]*"
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "`"
            },
            {
              "type": "PATTERN",
              "value": "[^\\\"]*"
            },
            {
              "type": "STRING",
              "value": "`"
            }
          ]
        }
      ]
    },
    "encapsulation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "open"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        },
        {
          "type": "SYMBOL",
          "name": "close"
        }
      ]
    },
    "open": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "<"
        }
      ]
    },
    "close": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "word": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+"
    },
    "punctuation": {
      "type": "PATTERN",
      "value": "[\\.,;]"
    },
    "operator": {
      "type": "PATTERN",
      "value": "[\\+\\-\\*\\/\\^=!?<>%~:]"
    },
    "special_char": {
      "type": "PATTERN",
      "value": "[^a-zA-Z0-9_\\-{}()\\[\\]<>]"
    },
    "white_space": {
      "type": "PATTERN",
      "value": "\\s"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
